{
  "name": "remotion-aem-showcase",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion preview src/index.tsx",
    "start:loyalty": "REMOTION_MOCK_FILE=loyalty remotion preview src/index.tsx",
    "start:ecommerce": "REMOTION_MOCK_FILE=ecommerce remotion preview src/index.tsx",
    "start:news": "REMOTION_MOCK_FILE=news remotion preview src/index.tsx",
    "start:global": "REMOTION_MOCK_FILE=global remotion preview src/index.tsx",
    "render": "remotion render src/index.tsx",
    "render:live:aem": "node scripts/render-live-aem.cjs AEMSpotlight-16x9 out/spotlight_aem_live.mp4",
    "render:live:intelligence": "node scripts/render-live-aem.cjs AEMCampaignIntelligence-16x9 out/spotlight_aem_intelligence.mp4",
    "render:live:aem:all": "node scripts/render-live-aem-all.cjs",
    "render:all": "npm run render -- AEMSpotlight-16x9 out/spotlight_16x9.mp4 && npm run render -- AEMSpotlight-9x16 out/spotlight_9x16.mp4 && npm run render -- AEMSpotlight-1x1 out/spotlight_1x1.mp4",
    "test": "vitest run --exclude src/test/e2e.test.ts",
    "test:watch": "vitest --exclude src/test/e2e.test.ts",
    "test:coverage": "vitest run --coverage --exclude src/test/e2e.test.ts",
    "test:e2e": "vitest run src/test/e2e.test.ts --testTimeout=300000",
    "build:wasm": "node scripts/build-spotlight-wasm.js",
    "upgrade": "remotion upgrade",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json}'",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run test",
    "prepare": "husky || true",
    "test:smoke": "npx remotion still src/index.tsx AEMSpotlight-16x9 out/smoke_16x9.png --frame=30 && npx remotion still src/index.tsx AEMSpotlight-9x16 out/smoke_9x16.png --frame=30 && npx remotion still src/index.tsx AEMSpotlight-1x1 out/smoke_1x1.png --frame=30",
    "deploy:aem": "npm run render -- AEMSpotlight-16x9 out/spotlight_prod.mp4 && node scripts/upload-to-aem.js out/spotlight_prod.mp4 $REMOTION_RENDER_DEST",
    "benchmark": "node scripts/benchmark-effects.js",
    "health": "npx tsx scripts/health-check.js",
    "health:json": "npx tsx scripts/health-check.js --json",
    "health:live": "npx tsx scripts/health-check.js --live",
    "health:ready": "npx tsx scripts/health-check.js --ready",
    "verify:aem": "node scripts/verify-aem.js",
    "verify:aem:json": "node scripts/verify-aem.js --json",
    "verify:provenance:db": "node scripts/verify-provenance-db.mjs",
    "worker:provenance": "node scripts/provenance-worker.mjs",
    "validate:media": "node scripts/validate-media.mjs",
    "load:test:provenance": "node scripts/load-test-provenance.mjs",
    "dev:web": "vite",
    "build:web": "vite build",
    "check:docs": "node scripts/check-doc-links.mjs",
    "preview:web": "vite preview",
    "build:server": "vite build --config vite.server.config.ts",
    "start:server": "node dist-server/server.mjs"
  },
  "dependencies": {
    "@remotion/player": "4.0.448",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.448",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.448",
    "@testing-library/react": "^14.1.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.1.4",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.6",
    "jsdom": "^23.2.0",
    "prettier": "^3.2.2",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "vitest": "^1.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
