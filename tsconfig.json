{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "jsx": "react-jsx",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "remotion.config.ts",
    "vitest.config.ts",
    "server.ts",
    "vite.server.config.ts",
    "web"
  ]
}
